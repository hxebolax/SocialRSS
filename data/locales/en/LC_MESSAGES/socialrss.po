msgstr "Exit\\tCtrl+Q"

msgid ""
"Se borrarán los datos seleccionados {0}. Esta acción no se puede "
"deshacer.\\n\\n¿Continuar?"
msgstr ""
"The selected data {0} will be deleted. This action cannot be "
"undone.\\n\\nContinue?"

