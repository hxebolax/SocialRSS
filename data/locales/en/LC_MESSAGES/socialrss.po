"Se reemplazarán tus datos actuales con los de esta copia (se guarda una \"\n"
"              \"copia previa por seguridad). Deberás reiniciar la aplicación.\\n\\n¿Continuar?"
msgstr ""
"Your current data will be replaced with this copy (a \"\n"
"\"previous copy for safety). You will have to restart the application.\\n\\nContinue?"

msgid "Se unieron {0} personas por este enlace:\\n\\n{1}"
msgstr "{0} people joined through this link:\\n\\n{1}"

msgid ""
